# Local development justfile for multi-peer transfer plan testing.
# Not committed upstream; lives in .gitignore or justfile.local.

REGISTRY := "quay.io/wseaton"
SERVER_IMAGE := REGISTRY + "/mx-server"
WORKER_IMAGE := REGISTRY + "/mx-worker-vllm"
NAMESPACE := "mx-test"
MODEL := "Qwen/Qwen2.5-14B-Instruct"
PLATFORM := "linux/amd64"

# Default tag: stamped per `just` invocation so each build/deploy cycle gets a
# fresh tag. Avoids the K8s containerd cache treating `:dev` as immutable and
# silently reusing an old digest. Override by passing tag=... to any recipe,
# but stay consistent within a cycle (use `just cycle` to build+deploy as one).
DEFAULT_TAG := `date +dev-%Y%m%d-%H%M%S`

# Build and push the MX server image
build-server tag=DEFAULT_TAG:
    podman build --platform {{PLATFORM}} -f ci/k8s/server/Dockerfile.server -t {{SERVER_IMAGE}}:{{tag}} .
    podman push {{SERVER_IMAGE}}:{{tag}}

# Build and push the vLLM worker image (with MX client installed)
build-worker tag=DEFAULT_TAG:
    podman build --platform {{PLATFORM}} -f examples/p2p_transfer_k8s/client/vllm/Dockerfile -t {{WORKER_IMAGE}}:{{tag}} .
    podman push {{WORKER_IMAGE}}:{{tag}}

# Build and push both images
build-all tag=DEFAULT_TAG: (build-server tag) (build-worker tag)

# Regenerate Python proto stubs after p2p.proto changes
proto-gen:
    uv run --with 'grpcio-tools==1.68.*' --with 'protobuf<6' python3 -m grpc_tools.protoc \
        -I modelexpress_common/proto \
        --python_out=modelexpress_client/python/modelexpress \
        --grpc_python_out=modelexpress_client/python/modelexpress \
        modelexpress_common/proto/p2p.proto
    sed -i '' 's/^import p2p_pb2 as/from . import p2p_pb2 as/' \
        modelexpress_client/python/modelexpress/p2p_pb2_grpc.py

# Create the test namespace with required secrets and CRDs
setup-ns:
    kubectl create namespace {{NAMESPACE}} --dry-run=client -o yaml | kubectl apply -f -
    kubectl apply -f examples/crds.yaml
    kubectl apply -n {{NAMESPACE}} -f examples/p2p_transfer_k8s/server/kubernetes_backend/rbac-modelmetadata.yaml
    @echo "Create hf-token-secret if it doesn't exist:"
    @echo "  kubectl -n {{NAMESPACE}} create secret generic hf-token-secret --from-literal=HF_TOKEN=\$HF_TOKEN"

# Deploy the MX coordination server
deploy-server tag=DEFAULT_TAG:
    MX_SERVER_IMAGE={{SERVER_IMAGE}}:{{tag}} \
        envsubst < ci/k8s/server/mx-server.yaml | kubectl apply -n {{NAMESPACE}} -f -
    kubectl -n {{NAMESPACE}} rollout status deployment/mx-server --timeout=120s

# Deploy source worker N (0-indexed)
deploy-source n tag=DEFAULT_TAG:
    JOB_NAME=mx-source-{{n}} \
    WORKER_IMAGE={{WORKER_IMAGE}}:{{tag}} \
    WORKER_PORT=8000 \
    MX_CI_MODEL={{MODEL}} \
        envsubst < ci/k8s/multi-peer/source.yaml | kubectl apply -n {{NAMESPACE}} -f -

# Deploy the target worker (with MX_USE_TRANSFER_PLAN=1)
deploy-target tag=DEFAULT_TAG:
    JOB_NAME=mx-target \
    WORKER_IMAGE={{WORKER_IMAGE}}:{{tag}} \
    WORKER_PORT=8000 \
    MX_CI_MODEL={{MODEL}} \
        envsubst < ci/k8s/multi-peer/target.yaml | kubectl apply -n {{NAMESPACE}} -f -

# Full iteration cycle: build both images and deploy server + sources, all
# sharing the same stamped tag. Use this for end-to-end iteration after code
# changes — guarantees the K8s node pulls a tag it has never seen.
cycle tag=DEFAULT_TAG: (build-all tag) (deploy-test tag)

# Deploy the full multi-peer test: server + 2 sources + 1 target
deploy-test tag=DEFAULT_TAG: (deploy-server tag) (deploy-source "0" tag) (deploy-source "1" tag)
    @echo "Waiting for sources to become READY..."
    @echo "Watch with: kubectl -n {{NAMESPACE}} get pods -w"
    @echo "Once both sources are serving, run: just -f justfile.local deploy-target {{tag}}"

# Tail target logs to verify multi-peer transfer
tail-target:
    kubectl -n {{NAMESPACE}} logs -f -l job-name=mx-target -c mx-target --tail=100

# Tail source logs
tail-source n:
    kubectl -n {{NAMESPACE}} logs -f -l job-name=mx-source-{{n}} -c mx-source-{{n}} --tail=100

# Check transfer plan diagnostics in server logs
tail-server:
    kubectl -n {{NAMESPACE}} logs -f -l app=mx-server --tail=100

# Check all pod status
status:
    kubectl -n {{NAMESPACE}} get pods -o wide
    @echo "---"
    kubectl -n {{NAMESPACE}} get modelmetadatas -o wide 2>/dev/null || true

# Clean up the test namespace
teardown:
    kubectl delete namespace {{NAMESPACE}} --ignore-not-found
