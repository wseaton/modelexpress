# ModelExpress coordinator (server) image for RHEL/UBI9.
#
# Multi-stage build that compiles the server from source on UBI9.
# Replaces the upstream Dockerfile's Ubuntu base with UBI9 for
# Red Hat / Konflux builds.
#
# Hermetic: every input is prefetched by Hermeto (cargo, rpm, generic) per
# docker/konflux/server/. Local build: ./docker/konflux/build-local.sh server
#
# Built --no-default-features --features openssl for FIPS. That drops the gcs
# feature along with rustls, so this image cannot pull models from GCS:
# google-cloud-auth hardcodes rustls. HuggingFace and NGC are unaffected.

FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:bcbf1fe577df63bd975ea19ebae604b5f072e1833b2bde417a0ffd4afd938b96 AS build

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        rust cargo cmake gcc gcc-c++ binutils perl \
        openssl-devel git-core unzip tar xz \
    && dnf clean all

# prost-build has needed a system protoc since 0.11, and RHEL ships no protoc
# RPM (only protobuf-c). Hermeto verifies the checksums in generic-fetcher.yaml.
ARG PROTOC_VERSION=35.1
RUN unzip -q /cachi2/output/deps/generic/protoc-${PROTOC_VERSION}-linux-$(uname -m).zip \
        -d /usr/local bin/protoc 'include/*' \
    && protoc --version

# Embeds the dependency tree in the binary for cargo audit bin and SBOM scanners
ARG CARGO_AUDITABLE_VERSION=0.7.5
RUN tar xJf /cachi2/output/deps/generic/cargo-auditable-${CARGO_AUDITABLE_VERSION}-$(uname -m).tar.xz \
        -C /usr/local/bin --strip-components=1 --wildcards '*/cargo-auditable' \
    && cargo auditable --version

WORKDIR /src
COPY . .
RUN __CARGO_TEST_CHANNEL_OVERRIDE_DO_NOT_USE_THIS=nightly CARGO_BUILD_SBOM=true \
    cargo auditable build -Z sbom --release --package modelexpress-server --bin modelexpress-server \
        --no-default-features --features openssl \
    && objdump -h target/release/modelexpress-server | grep -q '\.dep-v0' \
    && ci/check-fips-crypto.sh target/release/modelexpress-server \
    && cp target/release/modelexpress-server /modelexpress-server

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:7c372902c8d211db2d25c8277ba534a73b92742a334874dced829a63b0f21221

RUN microdnf install -y --nodocs ca-certificates openssl-libs \
    && microdnf clean all

COPY --from=build --chmod=0555 /modelexpress-server /usr/local/bin/modelexpress-server

COPY NOTICES /app/NOTICES

LABEL com.redhat.component="odh-modelexpress-container" \
      description="ModelExpress coordinator server for model routing and P2P metadata" \
      summary="ModelExpress coordinator server for model routing and P2P metadata" \
      name="odh-modelexpress-rhel9" \
      maintainer="['managed-open-data-hub@redhat.com']" \
      io.openshift.expose-services="8001:grpc" \
      io.k8s.display-name="odh-modelexpress" \
      io.k8s.description="odh-modelexpress" \
      com.redhat.license_terms="https://www.redhat.com/licenses/Red_Hat_Standard_EULA_20191108.pdf"

USER 65532:65532
EXPOSE 8001

ENV MODEL_EXPRESS_SERVER_PORT=8001
ENV MODEL_EXPRESS_LOG_LEVEL=info

ENTRYPOINT ["/usr/local/bin/modelexpress-server"]
